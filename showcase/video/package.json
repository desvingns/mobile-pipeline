{
  "name": "video",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor-assets.cjs",
    "voice": "node scripts/process-voice.cjs",
    "plan": "node scripts/build-video.cjs --plan-only",
    "music": "node scripts/process-music.cjs",
    "build": "node scripts/build-video.cjs && node scripts/carve.cjs",
    "lint": "npx --yes hyperframes@0.8.65 lint",
    "snapshots": "node scripts/build-video.cjs --print-snapshots",
    "verify": "node scripts/verify-output.cjs",
    "dev": "npx --yes hyperframes@0.8.65 preview",
    "check": "npx --yes hyperframes@0.8.65 check",
    "render": "npx --yes hyperframes@0.8.65 render",
    "publish": "npx --yes hyperframes@0.8.65 publish"
  },
  "devDependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@hyperframes/core": "^0.8.65",
    "gsap": "^3.14.2"
  }
}
